{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#monash-university-diploma","title":"\u83ab\u7eb3\u4ec0\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08Monash University diploma\uff09\u5b66\u5386\u6587\u51ed\u6837\u5f0f\u5bf9\u7167\u5c55\u793a","text":"<p>\u4f5c\u4e3a\u6fb3\u5927\u5229\u4e9a\u9876\u5c16\u7684\u201c\u516b\u5927\u540d\u6821\u201d\uff08Group of Eight\uff09\u4e4b\u4e00\uff0c\u83ab\u7eb3\u4ec0\u5927\u5b66\uff08Monash University\uff09\u7684\u6bd5\u4e1a\u8bc1\u5b66\u5386\u6587\u51ed\u5728\u56fd\u9645\u4e0a\u4eab\u6709\u6781\u9ad8\u7684\u58f0\u8a89\u4e0e\u8ba4\u53ef\u5ea6\u3002\u65e0\u8bba\u4f60\u662f\u5373\u5c06\u6bd5\u4e1a\u7684\u83ab\u7eb3\u4ec0\u5b66\u5b50\uff0c\u8fd8\u662f\u6b63\u5728\u89c4\u5212\u7559\u5b66\u7684\u51c6\u7559\u5b66\u751f\uff0c\u6df1\u5165\u4e86\u89e3\u83ab\u7eb3\u4ec0\u5927\u5b66\u5b98\u65b9\u6587\u51ed\u7684\u6392\u7248\u5e03\u5c40\u3001\u6838\u5fc3\u9632\u4f2a\u6280\u672f\u4ee5\u53ca\u4e0d\u540c\u5b66\u4f4d\u7684\u6837\u5f0f\u5dee\u5f02\uff0c\u90fd\u6709\u52a9\u4e8e\u4f60\u6e05\u6670\u638c\u63e1\u8fd9\u4e00\u9ad8\u542b\u91d1\u91cf\u8bc1\u4e66\u7684\u771f\u5b9e\u9762\u8c8c\u3002</p> <p>--&gt;</p> <p>\u672c\u6587\u5c06\u4e3a\u60a8\u5168\u65b9\u4f4d\u89e3\u6790\u83ab\u7eb3\u4ec0\u5927\u5b66\u6bd5\u4e1a\u8bc1\u7684\u6700\u65b0\u5b98\u65b9\u6837\u5f0f\uff0c\u5e76\u63d0\u4f9b\u8be6\u7ec6\u7684\u7ec6\u8282\u5bf9\u7167\u3002</p>"},{"location":"#_1","title":"\u83ab\u7eb3\u4ec0\u5927\u5b66\u6bd5\u4e1a\u8bc1\u5b98\u65b9\u6807\u51c6\u6837\u5f0f\u6df1\u5ea6\u5256\u6790","text":"<p>\u83ab\u7eb3\u4ec0\u5927\u5b66\u7684\u6587\u51ed\u8bbe\u8ba1\u517c\u5177\u82f1\u8054\u90a6\u4f20\u7edf\u5b66\u672f\u7684\u5e84\u4e25\u611f\u4e0e\u73b0\u4ee3\u7f8e\u5b66\u3002\u4e00\u4efd\u6b63\u5f0f\u7684\u83ab\u7eb3\u4ec0\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff0c\u5176\u4e3b\u4f53\u6392\u7248\u4e0e\u6838\u5fc3\u6587\u5b57\u901a\u5e38\u5305\u542b\u4ee5\u4e0b\u56fa\u5b9a\u6807\u51c6\uff1a</p> <ol> <li>\u6821\u540d\u9875\u7709\uff1a    \u9876\u90e8\u4ee5\u5bbd\u95f4\u8ddd\u7684\u7ecf\u5178\u5927\u5199\u5b57\u4f53\u5370\u6709 \u201cM O N A S H   U N I V E R S I T Y\u201d\u3002</li> <li>\u5927\u5b66\u5b98\u65b9\u5fbd\u7ae0\uff08Coat of Arms\uff09\uff1a    \u4f4d\u4e8e\u6821\u540d\u6b63\u4e0b\u65b9\u3002\u5fbd\u7ae0\u4e2d\u592e\u5305\u542b\u4e00\u672c\u6253\u5f00\u7684\u76fe\u5f62\u4e66\u672c\uff08\u4ee3\u8868\u77e5\u8bc6\uff09\u3001\u5357\u5341\u5b57\u661f\uff08\u4ee3\u8868\u5176\u6240\u5728\u7684\u6fb3\u5927\u5229\u4e9a\uff09\u4ee5\u53ca\u4e0b\u65b9\u7684\u6821\u8bad\u7f0e\u5e26 \u201cAncora Imparo\u201d\uff08\u610f\u4e3a\u201c\u6211\u4ecd\u5728\u5b66\u4e60\u201d\uff09\u3002</li> <li>\u9881\u53d1\u6388\u4fe1\u6587\u672c\uff1a    \u6b63\u6587\u4ee5\u4f18\u96c5\u7684\u659c\u4f53\u5b57\u5f00\u5934\uff1a\u201cIn the name and by the authority of the Council be it known that...\u201d\uff08\u7ecf\u5927\u5b66\u7406\u4e8b\u4f1a\u547d\u540d\u5e76\u6388\u6743\uff0c\u7279\u6b64\u5ba3\u544a\u2026\u2026\uff09\u3002</li> <li>\u6bd5\u4e1a\u751f\u59d3\u540d\u4e0e\u6bd5\u4e1a\u65f6\u95f4\uff1a    \u660e\u786e\u52a0\u7c97\u5370\u6709\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u59d3\u540d\uff0c\u5e76\u7cbe\u786e\u8bb0\u5f55\u6388\u4e88\u5b66\u4f4d\u7684\u5177\u4f53\u65e5\u671f\uff08\u5982\uff1aon the twentieth day of May 2026\uff09\u3002</li> <li>\u5b66\u4f4d\u4e0e\u4e13\u4e1a\u4fe1\u606f\uff1a    \u6e05\u6670\u6807\u6ce8\u6240\u83b7\u5b66\u4f4d\u7684\u7b49\u7ea7\u4e0e\u5177\u4f53\u4e13\u4e1a\u9886\u57df\u3002\u4f8b\u5982\uff1aMaster of Forensic Medicine\uff08\u6cd5\u533b\u5b66\u7855\u58eb\uff09\uff0c\u5e76\u4f1a\u7279\u522b\u6ce8\u660e\u8363\u8a89\u6216\u7ec6\u5206\u65b9\u5411\uff0c\u5982 awarded with distinction\uff08\u4f18\u79c0\u6bd5\u4e1a\u751f\uff09\u53ca specialising in Forensic odontology\uff08\u6cd5\u533b\u7259\u79d1\u5b66\u65b9\u5411\uff09\u3002</li> <li>\u7406\u4e8b\u4f1a\u5370\u9274\u6388\u6743\u58f0\u660e\uff1a    \u6587\u51ed\u4e0b\u65b9\u4f1a\u9644\u5e26\u4e00\u6bb5\u58f0\u660e\uff0c\u786e\u7acb\u8be5\u8bc1\u4e66\u5df2\u6b63\u5f0f\u52a0\u76d6\u5927\u5b66\u516c\u7ae0\uff08Common Seal\uff09\u3002</li> </ol>"},{"location":"#_2","title":"\u83ab\u7eb3\u4ec0\u5927\u5b66\u6587\u51ed\u9ad8\u9891\u641c\u7d22\u70ed\u70b9\u4e0e\u6838\u5fc3\u9632\u4f2a\u8bbe\u8ba1","text":"<p>\u5728\u767e\u5ea6\u6307\u6570\u4e0e\u8c37\u6b4c\u8d8b\u52bf\u4e2d\uff0c\u56f4\u7ed5\u201c\u7559\u5b66\u751f\u5b66\u5386\u8ba4\u8bc1\u201d\u3001\u201c\u6d77\u5916\u6bd5\u4e1a\u8bc1\u9632\u4f2a\u201d\u4ee5\u53ca\u201cMonash Diploma Verification\u201d\u7684\u641c\u7d22\u91cf\u5386\u6765\u9ad8\u4f01\u3002\u83ab\u7eb3\u4ec0\u5927\u5b66\u4e3a\u4e86\u786e\u4fdd\u6587\u51ed\u7684\u4e25\u8083\u6027\u4e0e\u4e0d\u53ef\u4f2a\u9020\u6027\uff0c\u5728\u7eb8\u8d28\u8bc1\u4e66\u4e0a\u5e94\u7528\u4e86\u591a\u9879\u5c16\u7aef\u7684\u7269\u7406\u9632\u4f2a\u6280\u672f\u3002</p>"},{"location":"#1-the-red-common-seal","title":"1. \u7329\u7ea2\u8272\u7acb\u4f53\u94a2\u5370\uff08The Red Common Seal\uff09","text":"<p>\u4f4d\u4e8e\u8bc1\u4e66\u5e95\u90e8\u6b63\u4e2d\u592e\u7684\u662f\u4e00\u679a\u76f4\u5f84\u8f83\u5927\u7684\u7329\u7ea2\u8272\u5706\u5f62\u9f7f\u8f6e\u72b6\u94a2\u5370\u3002\u8be5\u94a2\u5370\u4e0d\u4ec5\u989c\u8272\u9c9c\u8273\uff0c\u4e14\u5177\u6709\u660e\u663e\u7684\u51f9\u51f8\u89e6\u611f\u3002\u94a2\u5370\u4e2d\u5fc3\u523b\u6709\u83ab\u7eb3\u4ec0\u5927\u5b66\u7684\u6821\u5fbd\u56fe\u6848\uff0c\u8fb9\u7f18\u73af\u7ed5\u7740\u5927\u5b66\u7406\u4e8b\u4f1a\u7684\u5b98\u65b9\u82f1\u6587\u5b57\u6837\u3002</p>"},{"location":"#2-holographic-security-foil","title":"2. \u5de6\u4e0b\u89d2\u5168\u606f\u9632\u4f2a\u6807\u7b7e\uff08Holographic Security Foil\uff09","text":"<p>\u5728\u8bc1\u4e66\u7684\u5de6\u4e0b\u89d2\uff0c\u8bbe\u8ba1\u6709\u4e00\u4e2a\u65b9\u5f62\u7684\u6fc0\u5149\u5168\u606f\u9632\u4f2a\u56fe\u5c42\u3002\u4ece\u4e0d\u540c\u89d2\u5ea6\u89c2\u5bdf\u65f6\uff0c\u8be5\u6807\u7b7e\u4f1a\u53cd\u5c04\u51fa\u5f69\u8679\u822c\u7684\u5149\u6cfd\uff0c\u5e76\u663e\u73b0\u51fa\u83ab\u7eb3\u4ec0\u5927\u5b66\u7684\u7f29\u5199\u6216\u7279\u5b9a\u5b89\u5168\u6807\u8bc6\u3002\u8fd9\u662f\u8fd1\u5e74\u6765\u6d77\u5916\u9ad8\u6821\u7528\u4e8e\u675c\u7edd\u9ad8\u4eff\u6587\u51ed\u7684\u91cd\u8981\u6280\u672f\u624b\u6bb5\u3002</p>"},{"location":"#3","title":"3. \u5b98\u65b9\u53cc\u7b7e\u7ae0\u8ba4\u8bc1","text":"<p>\u6587\u51ed\u53f3\u4e0b\u65b9\u4e0e\u5de6\u4e0b\u65b9\u5206\u522b\u62e5\u6709\u5b66\u6821\u6838\u5fc3\u9ad8\u5c42\u7ba1\u7406\u4eba\u5458\u7684\u7b7e\u540d\uff1a * \u5de6\u4fa7\uff1a\u6821\u76d1\uff08Chancellor\uff09\u7684\u4eb2\u7b14\u6216\u6570\u5b57\u5316\u5b98\u65b9\u7b7e\u540d\u3002 * \u53f3\u4fa7\uff1a\u526f\u6821\u76d1\u517c\u6821\u957f\uff08Vice-Chancellor and President\uff09\u7684\u5b98\u65b9\u7b7e\u540d\u3002</p>"},{"location":"#_3","title":"\u4e0d\u540c\u5b66\u4f4d\u6587\u51ed\u6837\u5f0f\u4e0e\u6392\u7248\u5dee\u5f02\u5bf9\u7167","text":"<p>\u83ab\u7eb3\u4ec0\u5927\u5b66\u9488\u5bf9\u4e0d\u540c\u5b66\u672f\u5c42\u7ea7\uff08\u672c\u79d1\u3001\u7855\u58eb\u3001\u535a\u58eb\uff09\u7684\u6587\u51ed\uff0c\u5728\u4e3b\u89c6\u89c9\u548c\u63cf\u8ff0\u6587\u672c\u4e0a\u6709\u7740\u4e25\u8c28\u7684\u533a\u5206\u3002\u4ee5\u4e0b\u4e3a\u60a8\u68b3\u7406\u4e09\u5927\u6838\u5fc3\u5b66\u4f4d\u7684\u6837\u5f0f\u5bf9\u7167\u7279\u5f81\uff1a</p> \u5b66\u4f4d\u5c42\u7ea7 \u6838\u5fc3\u6587\u672c\u7279\u5f81 \u6837\u5f0f\u4e0e\u6392\u7248\u7279\u70b9 \u5b66\u58eb\u5b66\u4f4d (Bachelor Degree) \u901a\u5e38\u5305\u542b <code>Bachelor of...</code>\uff0c\u82e5\u662f\u8363\u8a89\u5b66\u58eb\u5219\u4f1a\u52a0\u4e0a <code>with Honours</code>\u3002 \u6574\u4f53\u8bbe\u8ba1\u6807\u51c6\u3001\u6d17\u7ec3\uff0c\u4e13\u4e1a\u65b9\u5411\u76f4\u63a5\u5217\u4e8e\u5b66\u4f4d\u540d\u79f0\u4e0b\u65b9\u3002 \u7855\u58eb\u5b66\u4f4d (Master Degree) \u6587\u672c\u901a\u5e38\u4e3a <code>Master of...</code>\u3002\u6210\u7ee9\u4f18\u5f02\u8005\u4f1a\u52a0\u6ce8 <code>awarded with distinction</code>\u3002 \u6b63\u6587\u884c\u6570\u8f83\u591a\u3002\u5982\u5b58\u5728\u7ec6\u5206\u7814\u7a76\u65b9\u5411\uff0c\u4f1a\u4ee5 <code>specialising in...</code> \u7684\u72ec\u7acb\u884c\u8fdb\u884c\u8865\u5145\u3002 \u535a\u58eb\u5b66\u4f4d (PhD / Doctoral) \u6838\u5fc3\u6587\u672c\u4e3a <code>Doctor of Philosophy</code>\u3002 \u8bc1\u4e66\u6392\u7248\u6700\u4e3a\u5e84\u91cd\uff0c\u901a\u5e38\u4f1a\u9644\u5e26\u7b80\u77ed\u7684\u8bba\u6587\u7814\u7a76\u5927\u65b9\u5411\u6216\u6240\u5c5e\u5b66\u9662\u8bf4\u660e\u3002"},{"location":"#_4","title":"\u83ab\u7eb3\u4ec0\u5927\u5b66\u5b66\u7c4d\u4e0e\u5b66\u5386\u8ba4\u8bc1\u7684\u5b98\u65b9\u6838\u9a8c\u6e20\u9053","text":"<p>\u62e5\u6709\u7b26\u5408\u6837\u5f0f\u7684\u6bd5\u4e1a\u8bc1\u53ea\u662f\u7b2c\u4e00\u6b65\u3002\u5728\u56fd\u9645\u5c31\u4e1a\u3001\u843d\u6237\u6216\u8fdb\u4e00\u6b65\u6df1\u9020\u65f6\uff0c\u6587\u51ed\u7684\u201c\u771f\u5b9e\u6027\u6838\u9a8c\u201d\u624d\u662f\u6838\u5fc3\u3002\u4ee5\u4e0b\u662f\u8c37\u6b4c\u8d8b\u52bf\u4e2d\u641c\u7d22\u9891\u7387\u6781\u9ad8\u7684\u4e24\u5927\u5b98\u65b9\u6838\u9a8c\u9014\u5f84\uff1a</p>"},{"location":"#1-monash-webenrol-my-equals","title":"1. \u83ab\u7eb3\u4ec0\u5927\u5b66\u5b98\u65b9\u7dda\u4e0a\u6838\u9a8c\u7cfb\u7edf\uff08Monash WebEnrol &amp; My eQuals\uff09","text":"<p>\u83ab\u7eb3\u4ec0\u5927\u5b66\u5df2\u5168\u9762\u63a5\u5165 My eQuals \u5e73\u53f0\u3002\u6bd5\u4e1a\u751f\u53ef\u4ee5\u83b7\u5f97\u5b98\u65b9\u8ba4\u8bc1\u7684\u6570\u5b57\u5316\u52a0\u5bc6\u6bd5\u4e1a\u8bc1\u4e0e\u6210\u7ee9\u5355\uff08Academic Transcripts\uff09\u3002\u7b2c\u4e09\u65b9\u673a\u6784\u6216\u96c7\u4e3b\u53ea\u9700\u901a\u8fc7\u6bd5\u4e1a\u751f\u5206\u4eab\u7684\u5b98\u65b9\u5b89\u5168\u94fe\u63a5\uff0c\u5373\u53ef\u5728\u7ebf\u5b9e\u65f6\u79d2\u7ea7\u6838\u9a8c\u6587\u51ed\u7684\u771f\u4f2a\uff0c\u65e0\u9700\u5b8c\u5168\u4f9d\u8d56\u7eb8\u8d28\u8bc1\u4e66\u3002</p>"},{"location":"#2-cscse","title":"2. \u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08CSCSE\uff09\u8ba4\u8bc1","text":"<p>\u5bf9\u4e8e\u9009\u62e9\u56de\u56fd\u53d1\u5c55\u7684\u7559\u5b66\u751f\u800c\u8a00\uff0c\u5728\u62ff\u5230\u83ab\u7eb3\u4ec0\u5927\u5b66\u7eb8\u8d28\u6bd5\u4e1a\u8bc1\u540e\uff0c\u5e94\u7b2c\u4e00\u65f6\u95f4\u767b\u5f55\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u7f51\u3002\u7559\u670d\u4e2d\u5fc3\u4f1a\u901a\u8fc7\u4e0e\u6fb3\u5927\u5229\u4e9a\u9ad8\u6821\u5b98\u65b9\u6570\u636e\u5e93\u76f4\u63a5\u5bf9\u63a5\uff0c\u6838\u5bf9\u8bc1\u4e66\u4e0a\u7684\u5b66\u751f\u59d3\u540d\u3001\u5b66\u4f4d\u540d\u79f0\u53ca\u9881\u53d1\u65f6\u95f4\uff08\u4f8b\u5982\u6587\u51ed\u6240\u793a\u76842026\u5e745\u670820\u65e5\u7b49\u4fe1\u606f\uff09\uff0c\u6838\u9a8c\u65e0\u8bef\u540e\u65b9\u53ef\u5f00\u5177\u300a\u56fd\u5916\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u4e66\u300b\u3002</p>"},{"location":"#_5","title":"\u603b\u7ed3","text":"<p>\u83ab\u7eb3\u4ec0\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08Monash University diploma\uff09\u4e0d\u4ec5\u662f\u4e00\u5f20\u4ee3\u8868\u5b66\u4e1a\u5706\u6ee1\u7ed3\u675f\u7684\u7eb8\u5f20\uff0c\u66f4\u662f\u73b0\u4ee3\u9632\u4f2a\u5de5\u827a\u4e0e\u767e\u5e74\u5b66\u672f\u79ef\u6dc0\u7684\u7ed3\u5408\u4f53\u3002\u901a\u8fc7\u672c\u6587\u5c55\u793a\u7684\u6821\u5fbd\u6392\u7248\u3001\u7279\u6b8a\u659c\u4f53\u6587\u672c\u3001\u7329\u7ea2\u94a2\u5370\u4ee5\u53ca\u5168\u606f\u9632\u4f2a\u56fe\u5c42\u7b49\u6807\u51c6\u6837\u5f0f\u7684\u5bf9\u7167\uff0c\u76f8\u4fe1\u80fd\u5e2e\u52a9\u60a8\u66f4\u52a0\u6e05\u6670\u3001\u76f4\u89c2\u5730\u4e86\u89e3\u83ab\u7eb3\u4ec0\u5927\u5b66\u5b66\u5386\u6587\u51ed\u7684\u771f\u5b9e\u98ce\u8c8c\u3002</p>"}]}